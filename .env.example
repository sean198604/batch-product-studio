# ===== Google AI Studio =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ===== 限流（防爆 429）=====
REQUEST_INTERVAL_SECONDS=3.5
SEMAPHORE_CONCURRENCY=1
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5,10,20

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 存储 & 数据库 =====
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
OUTPUTS_DIR=storage/outputs
DATA_DIR=data
SQLITE_PATH=data/app.db

# ===== 可选：代理（用于容器/国内网络访问 Google API）=====
# httpx 默认会读取以下环境变量（trust_env=True）
HTTP_PROXY=
HTTPS_PROXY=
