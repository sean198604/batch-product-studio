# ===== Google AI Studio =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ===== 限流（防爆 429）=====
REQUEST_INTERVAL_SECONDS=3.5
SEMAPHORE_CONCURRENCY=1
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5,10,20

# ===== 多任务并行池（4 任务并行 + FIFO 后退队列）=====
# 最多同时并行处理的任务数（每个任务内仍串行处理自己的图片）。
# 超过该数的任务按提交顺序进入严格 FIFO 后退队列。
MAX_CONCURRENT_TASKS=4

# ===== Agnes 默认模型（生成控制台默认选中）=====
# 留空 = 不指定，控制台默认沿用 GEMINI_MODEL。
# 仅在管理后台「Agnes AI 配置 → 默认模型」保存后生效（写入 data/settings.json）。
AGNES_DEFAULT_MODEL=

# ===== 注册门槛（达阈值后必须凭邀请码）=====
# 累计注册用户 ≥ 该值后，新注册必须提供管理员签发的注册邀请码。
# 设 0=立刻强制启用；设很大=实际上不强制。默认 20 人。
REGISTRATION_OPEN_USER_THRESHOLD=20

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 存储 & 数据库 =====
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
OUTPUTS_DIR=storage/outputs
DATA_DIR=data
SQLITE_PATH=data/app.db

# ===== 磁盘治理（自动清理 & 容量上限）=====
# storage 目录累计上限（MB），超过后自动清理最老任务并拒绝新上传
STORAGE_MAX_MB=10240
# 任务保留天数，超过后连同原图/生成图自动删除
STORAGE_RETENTION_DAYS=30
# 告警阈值（占上限比例 0.0~1.0），超过即写 data/storage_alert.json 供监控读取
STORAGE_WARN_RATIO=0.8
# 维护循环检查间隔（小时）
STORAGE_CLEANUP_INTERVAL_HOURS=6

# ===== 可选：代理（用于容器/国内网络访问 Google API）=====
# httpx 默认会读取以下环境变量（trust_env=True）
HTTP_PROXY=
HTTPS_PROXY=
